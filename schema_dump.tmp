CREATE OR REPLACE FUNCTION "public"."is_valid_email"("email_input" "text") RETURNS boolean
    LANGUAGE "plpgsql" IMMUTABLE
    SET "search_path" TO ''
    AS $_$
BEGIN
  RETURN email_input ~* '^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$';
END;
$_$;


ALTER FUNCTION "public"."is_valid_email"("email_input" "text") OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."link_producer_to_profile"("p_producer_id" "text", "p_profile_id" "uuid") RETURNS boolean
    LANGUAGE "plpgsql" SECURITY DEFINER
    SET "search_path" TO ''
    AS $$
BEGIN
  -- Vérifier que l'appelant est admin
  IF NOT auth_is_admin() THEN
    RAISE EXCEPTION 'Seuls les admins peuvent lier un producteur à un profil';
  END IF;

  -- Vérifier que le profil a le rôle producer
  IF NOT EXISTS (SELECT 1 FROM profiles WHERE id = p_profile_id AND role = 'producer') THEN
    RAISE EXCEPTION 'Le profil doit avoir le rôle producer';
  END IF;

  -- Lier le producteur au profil
  UPDATE producers
  SET profile_id = p_profile_id
  WHERE id = p_producer_id;

  RETURN TRUE;
END;
$$;


ALTER FUNCTION "public"."link_producer_to_profile"("p_producer_id" "text", "p_profile_id" "uuid") OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."link_user_code"("p_user_code" "text") RETURNS boolean
    LANGUAGE "plpgsql" SECURITY DEFINER
    SET "search_path" TO ''
    AS $$
DECLARE
  v_existing_profile_id UUID;
BEGIN
  SELECT id INTO v_existing_profile_id FROM profiles WHERE user_code = p_user_code AND id != auth.uid();
  IF v_existing_profile_id IS NOT NULL THEN
    RAISE EXCEPTION 'Ce code utilisateur est déjà lié à un autre compte';
  END IF;
  UPDATE profiles SET user_code = p_user_code WHERE id = auth.uid();
  RETURN TRUE;
END;
$$;


ALTER FUNCTION "public"."link_user_code"("p_user_code" "text") OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."log_product_update"() RETURNS "trigger"
    LANGUAGE "plpgsql" SECURITY DEFINER
    SET "search_path" TO ''
    AS $$
BEGIN
  -- Logger si changement de prix important
  IF OLD.price_public IS DISTINCT FROM NEW.price_public THEN
    PERFORM public.log_security_event(
      'product_price_change',
      'products',
      NEW.id::TEXT,
      TRUE,
      NULL,
      jsonb_build_object(
        'old_price', OLD.price_public,
        'new_price', NEW.price_public,
        'product_name', NEW.name
      )
    );
  END IF;
  RETURN NEW;
END;
$$;


ALTER FUNCTION "public"."log_product_update"() OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."log_security_event"("p_action_type" "text", "p_resource_type" "text" DEFAULT NULL::"text", "p_resource_id" "text" DEFAULT NULL::"text", "p_success" boolean DEFAULT true, "p_error_message" "text" DEFAULT NULL::"text", "p_metadata" "jsonb" DEFAULT NULL::"jsonb") RETURNS "void"
    LANGUAGE "plpgsql" SECURITY DEFINER
    SET "search_path" TO ''
    AS $$
BEGIN
  INSERT INTO public.security_audit_log (
    user_id,
    action_type,
    resource_type,
    resource_id,
    ip_address,
    success,
    error_message,
    metadata
  ) VALUES (
    auth.uid(),
    p_action_type,
    p_resource_type,
    p_resource_id,
    inet_client_addr(),
    p_success,
    p_error_message,
    p_metadata
  );
END;
$$;


ALTER FUNCTION "public"."log_security_event"("p_action_type" "text", "p_resource_type" "text", "p_resource_id" "text", "p_success" boolean, "p_error_message" "text", "p_metadata" "jsonb") OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."prevent_cdv_identity_change"() RETURNS "trigger"
    LANGUAGE "plpgsql"
    SET "search_path" TO ''
    AS $$
    BEGIN
      IF NEW.user_id IS DISTINCT FROM OLD.user_id THEN
        RAISE EXCEPTION 'user_id is immutable';
      END IF;
      IF NEW.producer_id IS DISTINCT FROM OLD.producer_id THEN
        RAISE EXCEPTION 'producer_id is immutable';
      END IF;
      RETURN NEW;
    END;
    $$;


