CREATE OR REPLACE FUNCTION "public"."prevent_mass_enumeration"() RETURNS "trigger"
    LANGUAGE "plpgsql" SECURITY DEFINER
    SET "search_path" TO ''
    AS $$
DECLARE
  v_query_count INTEGER;
  v_time_window INTERVAL := '10 seconds';
BEGIN
  -- Compter requêtes récentes de cet utilisateur
  SELECT COUNT(*) INTO v_query_count
  FROM public.security_audit_log
  WHERE user_id = auth.uid()
    AND action_type = 'mass_query_detected'
    AND created_at > NOW() - v_time_window;
  
  -- Si trop de requêtes, bloquer
  IF v_query_count > 100 THEN
    RAISE EXCEPTION 'Rate limit exceeded. Please wait before retrying.'
      USING HINT = 'Too many requests in short time window';
  END IF;
  
  RETURN NULL;
END;
$$;


ALTER FUNCTION "public"."prevent_mass_enumeration"() OWNER TO "postgres";


