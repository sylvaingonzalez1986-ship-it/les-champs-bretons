CREATE OR REPLACE FUNCTION "public"."update_user_tickets_timestamp"() RETURNS "trigger"
    LANGUAGE "plpgsql"
    SET "search_path" TO ''
    AS $$
BEGIN
  NEW.updated_at = now();
  RETURN NEW;
END;
$$;


ALTER FUNCTION "public"."update_user_tickets_timestamp"() OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."validate_file_upload"("p_bucket_name" "text", "p_file_path" "text", "p_file_size" bigint, "p_mime_type" "text", "p_file_header" "bytea" DEFAULT NULL::"bytea") RETURNS "jsonb"
    LANGUAGE "plpgsql" SECURITY DEFINER
    AS $$
DECLARE
  v_allowed allowed_mime_types%ROWTYPE;
  v_is_valid boolean := false;
  v_rejection_reason text := NULL;
  v_status text := 'rejected';
  v_result jsonb;
BEGIN
  SELECT * INTO v_allowed
  FROM allowed_mime_types
  WHERE mime_type = p_mime_type AND active = true;

  IF NOT FOUND THEN
    v_rejection_reason := 'Type de fichier non autorisé: ' || p_mime_type;
    v_status := 'rejected';
  ELSIF p_file_size > v_allowed.max_size_bytes THEN
    v_rejection_reason := 'Fichier trop volumineux. Max: ' || (v_allowed.max_size_bytes / 1048576) || 'MB';
    v_status := 'rejected';
  ELSIF p_file_header IS NOT NULL THEN
    v_is_valid := false;

    IF v_allowed.magic_bytes IS NOT NULL THEN
      FOR i IN 1..array_length(v_allowed.magic_bytes, 1) LOOP
        IF position(v_allowed.magic_bytes[i] in p_file_header) = 1 THEN
          v_is_valid := true;
          EXIT;
        END IF;
      END LOOP;

      IF NOT v_is_valid THEN
        v_rejection_reason := 'Signature de fichier invalide. Le fichier ne correspond pas au type déclaré.';
        v_status := 'suspicious';
      ELSE
        v_status := 'accepted';
      END IF;
    ELSE
      v_status := 'accepted';
    END IF;
  ELSE
    v_status := 'accepted';
  END IF;

  INSERT INTO upload_logs (
    user_id,
    bucket_name,
    file_path,
    file_size,
    mime_type,
    validation_status,
    rejection_reason
  ) VALUES (
    auth.uid(),
    p_bucket_name,
    p_file_path,
    p_file_size,
    p_mime_type,
    v_status,
    v_rejection_reason
  );

  v_result := jsonb_build_object(
    'valid', v_status = 'accepted',
    'status', v_status,
    'reason', v_rejection_reason,
    'max_size_mb', (v_allowed.max_size_bytes / 1048576)::int
  );

  RETURN v_result;
END;
$$;


ALTER FUNCTION "public"."validate_file_upload"("p_bucket_name" "text", "p_file_path" "text", "p_file_size" bigint, "p_mime_type" "text", "p_file_header" "bytea") OWNER TO "postgres";

