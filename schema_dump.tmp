CREATE OR REPLACE FUNCTION "public"."check_rate_limit"("p_ip_address" "inet", "p_action_type" "text", "p_user_id" "uuid" DEFAULT NULL::"uuid", "p_max_attempts" integer DEFAULT 5, "p_window_seconds" integer DEFAULT 60, "p_block_duration_seconds" integer DEFAULT 300) RETURNS "jsonb"
    LANGUAGE "plpgsql" SECURITY DEFINER
    SET "search_path" TO ''
    AS $$
DECLARE
  v_record RECORD;
  v_now TIMESTAMPTZ := NOW();
  v_window_start TIMESTAMPTZ := v_now - (p_window_seconds || ' seconds')::INTERVAL;
BEGIN
  -- Nettoyer les anciennes entrées (plus de 24h)
  DELETE FROM public.rate_limit_attempts 
  WHERE last_attempt_at < v_now - INTERVAL '24 hours';
  
  -- Chercher tentative existante
  SELECT * INTO v_record
  FROM public.rate_limit_attempts
  WHERE ip_address = p_ip_address 
    AND action_type = p_action_type
    AND (p_user_id IS NULL OR user_id = p_user_id);
  
  -- Si bloqué actuellement
  IF v_record.blocked_until IS NOT NULL AND v_record.blocked_until > v_now THEN
    RETURN jsonb_build_object(
      'allowed', false,
      'reason', 'rate_limited',
      'blocked_until', v_record.blocked_until,
      'retry_after_seconds', EXTRACT(EPOCH FROM (v_record.blocked_until - v_now))::INTEGER
    );
  END IF;
  
  -- Si window expirée, reset
  IF v_record.first_attempt_at IS NULL OR v_record.first_attempt_at < v_window_start THEN
    IF v_record.id IS NOT NULL THEN
      UPDATE public.rate_limit_attempts
      SET attempts_count = 1,
          first_attempt_at = v_now,
          last_attempt_at = v_now,
          blocked_until = NULL
      WHERE id = v_record.id;
    ELSE
      INSERT INTO public.rate_limit_attempts (ip_address, action_type, user_id, attempts_count, first_attempt_at, last_attempt_at)
      VALUES (p_ip_address, p_action_type, p_user_id, 1, v_now, v_now);
    END IF;
    
    RETURN jsonb_build_object('allowed', true, 'attempts_remaining', p_max_attempts - 1);
  END IF;
  
  -- Incrémenter tentatives
  IF v_record.attempts_count >= p_max_attempts THEN
    -- Bloquer
    UPDATE public.rate_limit_attempts
    SET blocked_until = v_now + (p_block_duration_seconds || ' seconds')::INTERVAL,
        last_attempt_at = v_now
    WHERE id = v_record.id;
    
    RETURN jsonb_build_object(
      'allowed', false,
      'reason', 'rate_limited',
      'blocked_until', v_now + (p_block_duration_seconds || ' seconds')::INTERVAL,
      'retry_after_seconds', p_block_duration_seconds
    );
  ELSE
    -- Incrémenter
    UPDATE public.rate_limit_attempts
    SET attempts_count = attempts_count + 1,
        last_attempt_at = v_now
    WHERE id = v_record.id;
    
    RETURN jsonb_build_object(
      'allowed', true, 
      'attempts_remaining', p_max_attempts - v_record.attempts_count - 1
    );
  END IF;
END;
$$;


ALTER FUNCTION "public"."check_rate_limit"("p_ip_address" "inet", "p_action_type" "text", "p_user_id" "uuid", "p_max_attempts" integer, "p_window_seconds" integer, "p_block_duration_seconds" integer) OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."create_direct_sale_order"("p_user_id" "uuid", "p_producer_id" "text", "p_items" "jsonb") RETURNS "uuid"
    LANGUAGE "plpgsql" SECURITY DEFINER
    SET "search_path" TO 'public'
    AS $$
DECLARE
  v_order_id uuid;
  v_item jsonb;
  v_product record;
  v_total numeric := 0;
  v_qty integer;
  v_unit numeric;
  v_line_total numeric;
  v_producer record;
BEGIN
  IF jsonb_typeof(p_items) <> 'array' THEN
    RAISE EXCEPTION 'INVALID_ITEMS';
  END IF;

  SELECT adresse_retrait, horaires_retrait, instructions_retrait
    INTO v_producer
  FROM producers
  WHERE id = p_producer_id;

  IF NOT FOUND THEN
    RAISE EXCEPTION 'PRODUCER_NOT_FOUND';
  END IF;

  INSERT INTO commandes_vente_directe (
    user_id,
    producer_id,
    total,
    statut,
    adresse_retrait,
    horaires_retrait,
    instructions_retrait
  ) VALUES (
    p_user_id,
    p_producer_id,
    0,
    'en_attente',
    COALESCE(v_producer.adresse_retrait, ''),
    COALESCE(v_producer.horaires_retrait, ''),
    v_producer.instructions_retrait
  )
  RETURNING id INTO v_order_id;

  FOR v_item IN SELECT * FROM jsonb_array_elements(p_items)
  LOOP
    v_qty := COALESCE((v_item->>'quantity')::int, 0);
    IF v_qty <= 0 THEN
      RAISE EXCEPTION 'INVALID_QUANTITY';
    END IF;

    SELECT id, producer_id, price_public
      INTO v_product
    FROM products
    WHERE id = (v_item->>'productId')::text;

    IF NOT FOUND OR v_product.producer_id <> p_producer_id THEN
      RAISE EXCEPTION 'INVALID_PRODUCT';
    END IF;

    v_unit := COALESCE(v_product.price_public, 0);
    v_line_total := v_unit * v_qty;
    v_total := v_total + v_line_total;

    INSERT INTO lignes_commande_vente_directe (
      commande_id,
      product_id,
      quantite,
      prix_unitaire,
      sous_total
    ) VALUES (
      v_order_id,
      v_product.id,
      v_qty,
      v_unit,
      v_line_total
    );
  END LOOP;

  IF v_total < 20 THEN
    RAISE EXCEPTION 'MINIMUM_AMOUNT_NOT_MET';
  END IF;

  UPDATE commandes_vente_directe
    SET total = v_total
  WHERE id = v_order_id;

  RETURN v_order_id;
EXCEPTION WHEN OTHERS THEN
  IF v_order_id IS NOT NULL THEN
    DELETE FROM commandes_vente_directe WHERE id = v_order_id;
  END IF;
  RAISE;
END;
$$;


ALTER FUNCTION "public"."create_direct_sale_order"("p_user_id" "uuid", "p_producer_id" "text", "p_items" "jsonb") OWNER TO "postgres";


