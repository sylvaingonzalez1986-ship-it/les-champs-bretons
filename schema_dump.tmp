CREATE OR REPLACE FUNCTION "public"."add_user_lot"("p_user_id" "uuid", "p_lot_id" "text", "p_lot_name" "text", "p_lot_description" "text" DEFAULT NULL::"text", "p_lot_rarity" "text" DEFAULT NULL::"text", "p_lot_image" "text" DEFAULT NULL::"text", "p_lot_value" numeric DEFAULT 0, "p_lot_type" "text" DEFAULT 'product'::"text", "p_discount_percent" integer DEFAULT NULL::integer, "p_discount_amount" numeric DEFAULT NULL::numeric, "p_min_order_amount" numeric DEFAULT NULL::numeric) RETURNS "uuid"
    LANGUAGE "plpgsql" SECURITY DEFINER
    SET "search_path" TO ''
    AS $$
DECLARE
  v_new_id UUID;
BEGIN
  INSERT INTO user_lots (
    user_id, lot_id, lot_name, lot_description, lot_rarity, lot_image,
    lot_value, lot_type, discount_percent, discount_amount, min_order_amount, won_at
  ) VALUES (
    p_user_id, p_lot_id, p_lot_name, p_lot_description, p_lot_rarity, p_lot_image,
    p_lot_value, p_lot_type, p_discount_percent, p_discount_amount, p_min_order_amount,
    NOW()
  )
  RETURNING id INTO v_new_id;
  
  RETURN v_new_id;
END;
$$;


ALTER FUNCTION "public"."add_user_lot"("p_user_id" "uuid", "p_lot_id" "text", "p_lot_name" "text", "p_lot_description" "text", "p_lot_rarity" "text", "p_lot_image" "text", "p_lot_value" numeric, "p_lot_type" "text", "p_discount_percent" integer, "p_discount_amount" numeric, "p_min_order_amount" numeric) OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."admin_reset_rate_limit"("p_ip_address" "inet", "p_action_type" "text" DEFAULT NULL::"text") RETURNS "void"
    LANGUAGE "plpgsql" SECURITY DEFINER
    SET "search_path" TO ''
    AS $$
BEGIN
  IF p_action_type IS NULL THEN
    DELETE FROM public.rate_limit_attempts WHERE ip_address = p_ip_address;
  ELSE
    DELETE FROM public.rate_limit_attempts 
    WHERE ip_address = p_ip_address AND action_type = p_action_type;
  END IF;
END;
$$;


ALTER FUNCTION "public"."admin_reset_rate_limit"("p_ip_address" "inet", "p_action_type" "text") OWNER TO "postgres";


