CREATE OR REPLACE FUNCTION "public"."create_user_data"() RETURNS "trigger"
    LANGUAGE "plpgsql" SECURITY DEFINER
    SET "search_path" TO ''
    AS $$
BEGIN
  INSERT INTO user_subscriptions (user_id, subscription_tier, tickets)
  VALUES (NEW.id, 'none', 0)
  ON CONFLICT (user_id) DO NOTHING;
  
  INSERT INTO user_referrals (user_id, referral_code, points)
  VALUES (NEW.id, UPPER(SUBSTRING(MD5(NEW.id::text || NOW()::text) FROM 1 FOR 8)), 0)
  ON CONFLICT (user_id) DO NOTHING;
  
  INSERT INTO user_stats (user_id, total_spins)
  VALUES (NEW.id, 0)
  ON CONFLICT (user_id) DO NOTHING;
  
  RETURN NEW;
END;
$$;


ALTER FUNCTION "public"."create_user_data"() OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."delete_user_account"("p_confirmation_text" "text") RETURNS "jsonb"
    LANGUAGE "plpgsql" SECURITY DEFINER
    SET "search_path" TO ''
    AS $$
DECLARE
  v_user_id uuid;
  v_user_email text;
  v_user_code text;
  v_producer_id text;
  v_request_id uuid;
  v_orders_count int;
  v_products_count int;
BEGIN
  IF p_confirmation_text != 'SUPPRIMER MON COMPTE' THEN
    RETURN jsonb_build_object('success', false, 'error', 'Confirmation invalide');
  END IF;

  v_user_id := auth.uid();
  IF v_user_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Non authentifié');
  END IF;

  SELECT email, user_code INTO v_user_email, v_user_code FROM profiles WHERE id = v_user_id;
  SELECT id INTO v_producer_id FROM producers WHERE profile_id = v_user_id;

  INSERT INTO rgpd_requests (user_id, request_type, status)
  VALUES (v_user_id, 'delete', 'processing') RETURNING id INTO v_request_id;

  -- Anonymiser les commandes
  UPDATE orders SET
    customer_name = 'Utilisateur supprimé',
    customer_email = 'deleted-' || v_user_id || '@anonymized.local',
    customer_phone = NULL, delivery_address = 'Adresse supprimée',
    delivery_name = NULL, notes = NULL, user_id = NULL
  WHERE customer_email = v_user_email OR user_id = v_user_id;
  GET DIAGNOSTICS v_orders_count = ROW_COUNT;

  -- Supprimer produits et producteur
  IF v_producer_id IS NOT NULL THEN
    DELETE FROM products WHERE producer_id = v_producer_id;
    GET DIAGNOSTICS v_products_count = ROW_COUNT;
    DELETE FROM producers WHERE id = v_producer_id;
  ELSE
    v_products_count := 0;
  END IF;

  -- Supprimer lots et profil
  DELETE FROM user_lots WHERE user_id = v_user_id OR user_code = v_user_code;
  DELETE FROM profiles WHERE id = v_user_id;

  UPDATE rgpd_requests SET status = 'completed', processed_at = now(),
    notes = format('Commandes: %s, Produits: %s', v_orders_count, v_products_count)
  WHERE id = v_request_id;

  RETURN jsonb_build_object(
    'success', true, 'message', 'Compte supprimé', 'request_id', v_request_id,
    'details', jsonb_build_object('orders_anonymized', v_orders_count, 'products_deleted', v_products_count)
  );
END;
$$;


ALTER FUNCTION "public"."delete_user_account"("p_confirmation_text" "text") OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."export_user_data"() RETURNS "jsonb"
    LANGUAGE "plpgsql" SECURITY DEFINER
    SET "search_path" TO ''
    AS $$
DECLARE
  v_user_id uuid;
  v_user_email text;
  v_export_data jsonb;
  v_profile_data jsonb;
  v_orders_data jsonb;
  v_products_data jsonb;
  v_lots_data jsonb;
  v_request_id uuid;
BEGIN
  v_user_id := auth.uid();
  IF v_user_id IS NULL THEN
    RETURN jsonb_build_object('error', 'Non authentifié');
  END IF;

  SELECT email INTO v_user_email FROM profiles WHERE id = v_user_id;

  SELECT to_jsonb(p.*) - 'id' INTO v_profile_data FROM profiles p WHERE p.id = v_user_id;

  SELECT COALESCE(jsonb_agg(jsonb_build_object(
    'order_id', o.id, 'created_at', o.created_at, 'status', o.status,
    'total', o.total, 'items_count', jsonb_array_length(o.items)
  ) ORDER BY o.created_at DESC), '[]'::jsonb) INTO v_orders_data
  FROM orders o WHERE o.customer_email = v_user_email OR o.user_id = v_user_id;

  SELECT COALESCE(jsonb_agg(jsonb_build_object(
    'product_id', prod.id, 'name', prod.name, 'category', prod.category,
    'price', prod.price, 'created_at', prod.created_at
  ) ORDER BY prod.created_at DESC), '[]'::jsonb) INTO v_products_data
  FROM products prod JOIN producers pr ON prod.producer_id = pr.id WHERE pr.profile_id = v_user_id;

  SELECT COALESCE(jsonb_agg(jsonb_build_object(
    'lot_name', ul.lot_name, 'won_at', ul.won_at, 'used', ul.used
  ) ORDER BY ul.won_at DESC), '[]'::jsonb) INTO v_lots_data
  FROM user_lots ul WHERE ul.user_id = v_user_id;

  INSERT INTO rgpd_requests (user_id, request_type, status, processed_at)
  VALUES (v_user_id, 'export', 'completed', now()) RETURNING id INTO v_request_id;

  v_export_data := jsonb_build_object(
    'export_info', jsonb_build_object(
      'generated_at', now(), 'request_id', v_request_id, 'user_email', v_user_email,
      'data_controller', 'SASU Les Champs Bretons'
    ),
    'profile', v_profile_data,
    'orders', v_orders_data,
    'products_created', v_products_data,
    'lots_won', v_lots_data
  );

  RETURN v_export_data;
END;
$$;


ALTER FUNCTION "public"."export_user_data"() OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."get_allowed_mime_types"("p_category" "text" DEFAULT NULL::"text") RETURNS TABLE("mime_type" "text", "max_size_mb" integer, "description" "text")
    LANGUAGE "plpgsql" STABLE SECURITY DEFINER
    SET "search_path" TO ''
    AS $$
BEGIN
  RETURN QUERY
  SELECT
    amt.mime_type,
    (amt.max_size_bytes / 1048576)::int as max_size_mb,
    amt.description
  FROM allowed_mime_types amt
  WHERE amt.active = true
    AND (p_category IS NULL OR amt.category = p_category)
  ORDER BY amt.category, amt.mime_type;
END;
$$;


ALTER FUNCTION "public"."get_allowed_mime_types"("p_category" "text") OWNER TO "postgres";


