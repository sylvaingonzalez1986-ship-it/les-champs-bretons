  IF NEW.device_id IS DISTINCT FROM OLD.device_id THEN
    IF auth.role() <> 'service_role' AND NOT is_admin() THEN
      RAISE EXCEPTION 'device_id is immutable';
    END IF;
  END IF;
  RETURN NEW;
END;
$$;


