CREATE OR REPLACE FUNCTION "public"."award_tickets"("p_user_id" "uuid", "p_amount" integer, "p_source" "text", "p_source_details" "jsonb" DEFAULT NULL::"jsonb") RETURNS TABLE("new_balance" integer)
    LANGUAGE "plpgsql" SECURITY DEFINER
    SET "search_path" TO ''
    AS $$
DECLARE
  v_new_balance INTEGER;
BEGIN
  IF p_amount <= 0 THEN
    RAISE EXCEPTION 'Amount must be positive';
  END IF;

  INSERT INTO user_tickets (user_id, balance, lifetime_earned)
  VALUES (p_user_id, p_amount, p_amount)
  ON CONFLICT (user_id) DO UPDATE SET
    balance = user_tickets.balance + p_amount,
    lifetime_earned = user_tickets.lifetime_earned + p_amount,
    updated_at = now()
  RETURNING user_tickets.balance INTO v_new_balance;

  INSERT INTO ticket_transactions (
    user_id,
    amount,
    balance_after,
    source,
    source_details
  ) VALUES (
    p_user_id,
    p_amount,
    v_new_balance,
    p_source,
    p_source_details
  );

  RETURN QUERY SELECT v_new_balance;
END;
$$;


ALTER FUNCTION "public"."award_tickets"("p_user_id" "uuid", "p_amount" integer, "p_source" "text", "p_source_details" "jsonb") OWNER TO "postgres";


